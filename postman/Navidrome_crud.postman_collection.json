    {
      "name": "Admin does not find the deleted playlsit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst body = pm.response.json();\r\npm.test(\"Response is an array\", function () {\r\n    pm.expect(body).to.be.an('array');\r\n});\r\n\r\nconst foundPlaylist = body.some(item => item.id === pm.collectionVariables.get(\"playlistId\"));\r\npm.test(\"Deleted playlist cannot be found\", function() {\r\n    pm.expect(foundPlaylist).to.be.false;\r\n});"
            ]
          }
        }
      ],
