    {
      "name": "Admin creates a playlist",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst body = pm.response.json();\r\nconst playlistId = body.id;\r\npm.collectionVariables.set(\"playlistId\", playlistId);\r\n"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const playlistName = `pm_crud_${Date.now()}`;\r\npm.collectionVariables.set(\"playlistName\", playlistName);\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\": \"{{playlistName}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/playlist",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "playlist"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Admin sees the playlist",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is an array\", function () {\r\n    pm.expect(body).to.be.an('array');\r\n});\r\n\r\npm.test(\"Response object contains all 16 properties\", function () {\r\n    pm.expect(body[0]).to.have.property('id');\r\n    pm.expect(body[0]).to.have.property('name');\r\n    pm.expect(body[0]).to.have.property('comment');\r\n    pm.expect(body[0]).to.have.property('duration');\r\n    pm.expect(body[0]).to.have.property('size');\r\n    pm.expect(body[0]).to.have.property('songCount');\r\n    pm.expect(body[0]).to.have.property('ownerName');\r\n    pm.expect(body[0]).to.have.property('ownerId');\r\n    pm.expect(body[0]).to.have.property('public');\r\n    pm.expect(body[0]).to.have.property('path');\r\n    pm.expect(body[0]).to.have.property('sync');\r\n    pm.expect(body[0]).to.have.property('uploadedImage');\r\n    pm.expect(body[0]).to.have.property('createdAt');\r\n    pm.expect(body[0]).to.have.property('updatedAt');\r\n    pm.expect(body[0]).to.have.property('rules');\r\n    pm.expect(body[0]).to.have.property('evaluatedAt');\r\n})\r\n\r\n"
            ]
          }
        }
      ],
