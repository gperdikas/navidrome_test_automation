          "script": {
            "type": "text/javascript",
            "exec": [
              "const playlistName = `pm_crud_${Date.now()}`;\r\npm.collectionVariables.set(\"playlistName\", playlistName);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst body = pm.response.json();\r\nconst publicPlaylistId = body.id;\r\npm.collectionVariables.set(\"publicPlaylistId\", publicPlaylistId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-nd-authorization",
            "value": "Bearer {{token_user1}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\": \"{{playlistName}}\",\r\n    \"public\": true\r\n}",
