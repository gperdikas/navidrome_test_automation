  "item": [
    {
      "name": "User1 logs in",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\r\nconst token_user1 = response.token;\r\npm.environment.set(\"token_user1\", token_user1);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"userTest1\",\r\n    \"password\": \"userTest1\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "User1 creates private playlist",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Playlist is private\", function () {\r\n    pm.response.to.have.public(false);\r\n});\r\n\r\nconst body = pm.response.json();\r\nconst privatePlaylistId = body.id;\r\npm.collectionVariables.set(\"privatePlaylistId\", privatePlaylistId);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const playlistName = `pm_auth_${Date.now()}`;\r\npm.collectionVariables.set(\"playlistName\", playlistName);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-nd-authorization",
            "value": "Bearer {{token_user1}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\": \"{{playlistName}}\",\r\n    \"public\": false\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/playlist",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "playlist"
          ]
        }
      },
      "response": []
    },
