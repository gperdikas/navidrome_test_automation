  "item": [
    {
      "name": "User1 logs in",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\r\n\r\nconst token_user1 = response.token;\r\npm.environment.set(\"token_user1\", token_user1);\r\n\r\nconst user1Id = response.id;\r\npm.collectionVariables.set(\"user1Id\", user1Id);\r\n\r\nconst user1Name = response.name;\r\npm.collectionVariables.set(\"user1Name\", user1Name);\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"userTest1 login returns a token\", () => {\r\n    pm.expect(token_user1).to.be.a(\"string\").and.not.be.empty;\r\n});\r\n\r\npm.test(\"userTest1 login returns an id\", () => {\r\n    pm.expect(user1Id).to.be.a(\"string\").and.not.be.empty;\r\n});\r\n\r\npm.test(\"userTest1 login returns a name\", () => {\r\n    pm.expect(user1Name).to.be.a(\"string\").and.not.be.empty;\r\n})"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"userTest1\",\r\n    \"password\": \"userTest1\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
